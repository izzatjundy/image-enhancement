function J = myIntensityTransform(I, type, c, gamma, lowIn, highIn, lowOut, highOut)
% myIntensityTransform melakukan transformasi intensitas citra (Pixel-Wise).
%
% Input:
%   I       : Citra masukan uint8 (Grayscale atau RGB)
%   type    : Jenis transformasi ('Negative', 'Log Transform', 'Gamma (Power-law)', 'Linear Stretch')
%   c       : Konstanta skalar
%   gamma   : Nilai pangkat gamma untuk Power-law
%   lowIn, highIn   : Rentang intensitas masukan untuk Contrast Stretching
%   lowOut, highOut : Rentang intensitas luaran untuk Contrast Stretching
%
% Output:
%   J       : Citra hasil transformasi uint8 (ukuran dan channel sama dengan I)

I_double = double(I);

switch type
    case 'Negative'
        % Citra negatif : s = 255 - r
        J_double = 255 - I_double;

    case 'Log Transform'
        % Transformasi log : s = c*log(1+s)
        J_double = c * log(1 + I_double);

        if max(J_double(:)) > 0
            J_double = (J_double/max(J_double(:))) * 255;
        end

    case 'Gamma Power-Law'
        % Transformasi gamma : s = c * (r / 255)^gamma * 255
        I_norm = I_double / 255.0;
        J_double = c * (I_norm .^ gamma) * 255.0;

    case 'Linear Stretch'
        rangeIn = highIn - lowIn;
        if rangeIn == 0
            rangeIn = 1;
        end
